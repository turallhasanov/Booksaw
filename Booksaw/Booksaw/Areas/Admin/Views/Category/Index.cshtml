
@model IEnumerable<CategoryUIVM>
<div class="col-lg-6 grid-margin stretch-card">
    <div class="card">
        <div class="card-body">
            <h4 class="card-title">Category</h4>
            <p class="card-description">
                <a asp-action="Create" class="badge badge-success"> Create </a>
            </p>
            <div class="table-responsive">
                <table class="table">
                    <thead>
                        <tr>
                            <th>Category Name</th>
                            <th>Operations</th> 

                            @foreach (var item in Model.OrderByDescending(m => m.Id))
                            {
                                
                            <tr>
                                <td>@item.Name</td>
                                <td>
                                    <a asp-action="Detail" asp-route-id="@item.Id" class="badge badge-primary"> Detail </a>
                                    <form class="d-inline" method="post" asp-action="Delete" asp-route-id="@item.Id">
                                        <button type="submit" class="badge badge-danger"> Delete </button>
                                    </form>

                                    <a class="badge badge-warning"> Edit </a>
                                <td>
                            </tr>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        
                       
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>